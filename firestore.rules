rules_version = '2';

// NOTE: These rules use the Firebase Client SDK (not Admin SDK).
// API routes run as unauthenticated clients, so server-side writes must be
// permitted below. Real security is enforced by the Next.js API routes themselves.
// To fully lock down server writes, migrate lib/firebase.ts to firebase-admin.

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      // Anyone authenticated can read their own orders
      allow read: if request.auth != null
                  && request.auth.token.email == resource.data.email;

      // Permit server-side (unauthenticated client SDK in API routes) to create
      // orders with valid required fields
      allow create: if request.resource.data.keys().hasAll([
                        "paystackRef", "network", "beneficiary",
                        "packageId", "amount", "email", "status"
                      ])
                    && request.resource.data.status == "Pending"
                    && request.resource.data.amount > 0;

      // Only allow updates that change status or orderId — no other fields
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(["status", "orderId", "updatedAt"]);

      // No client-side deletes ever
      allow delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
